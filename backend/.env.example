# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/monthly_budget

# Optional: Alembic-only connection URL. Falls back to DATABASE_URL when unset.
# Only needed against hosted Supabase's transaction pooler (see below), whose
# port 6543 rejects the named prepared statements Alembic's DDL requires --
# point this at the session pooler or direct connection instead.
# DATABASE_MIGRATION_URL=postgresql+asyncpg://user:pass@localhost:5432/monthly_budget
#
# Hosted Supabase connection strings (see docs/data-layer-ports-design.md,
# "Connecting to hosted Supabase"), one example per mode:
#
# Supavisor transaction pooler (:6543) -- app traffic only; NOT valid for
# DATABASE_MIGRATION_URL. IPv4-safe.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Supavisor session pooler (:5432 on the pooler host) -- safe for both app
# traffic and migrations. IPv4-safe, so this is what CI runners without IPv6
# egress must use.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Direct connection -- safe for both app traffic and migrations, but the host
# is IPv6-only unless Supabase's paid IPv4 add-on is purchased.
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Redis Configuration
REDIS_URL=redis://:password@localhost:6379/0

# JWT Configuration
JWT_SECRET=change-me
# Access JWT lifetime (minutes). Short-lived; refreshed via the refresh cookie.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh JWT lifetime (days). Bounds the overall signed-in session.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# LLM Configuration (receipt scanning via OpenRouter's OpenAI-compatible API)
OPENROUTER_API_KEY=change-me
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-5.5
# Optional OpenRouter attribution headers (HTTP-Referer / X-Title)
LLM_HTTP_REFERER=
LLM_APP_TITLE=
# ANTHROPIC_MOCK / ANTHROPIC_MOCK_SCENARIO are still accepted as aliases.
LLM_MOCK=false
LLM_MOCK_SCENARIO=success

# Category auto-suggest: OpenRouter System One decision model (same OPENROUTER_API_KEY)
DECISION_MODEL=microsoft/microsoft-decision-1
DECISION_MIN_CONFIDENCE=0.5
DECISION_TIMEOUT_SECONDS=3.0
DECISION_MOCK=false
DECISION_MOCK_SCENARIO=success

# Release version reported by GET /api/version (images get it from the release tag)
APP_VERSION=dev
