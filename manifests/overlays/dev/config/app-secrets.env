# =============================================================================
# THROWAWAY LOCAL DEV CREDENTIALS -- NOT SECRETS.
#
# Every value below is a placeholder that exists only inside an ephemeral k3d
# cluster on a developer laptop. They intentionally mirror the dummy values in
# the repo's .env.example. Nothing here is, or may become, a real credential:
# do not reuse these strings anywhere that is reachable from outside localhost.
#
# detect-secrets: this file will trip the repo's detect-secrets hook. It cannot
# be silenced with inline `# pragma: allowlist secret` markers, because
# kustomize does NOT strip trailing comments from env files -- `FOO=bar # x`
# becomes the literal value "bar # x" and would corrupt the password. Allowlist
# this file by re-baselining instead:
#     detect-secrets scan --baseline .secrets.baseline
# =============================================================================

POSTGRES_PASSWORD=changeme_postgres_password
REDIS_PASSWORD=changeme_redis_password

SECRET_KEY=changeme_secret_key_min_32_chars_long
JWT_SECRET=changeme_jwt_secret_min_32_chars_long

# Assembled connection URLs. These are set literally rather than interpolated
# from the parts above: kustomize has no string templating, and Kubernetes
# $(VAR) expansion does not reach into ConfigMap/Secret values. If you change a
# password above you MUST change it here too.
# Hosts are the in-cluster Services: postgres:5432 and redis:6379.
DATABASE_URL=postgresql+asyncpg://monthly_budget:changeme_postgres_password@postgres:5432/monthly_budget
REDIS_URL=redis://:changeme_redis_password@redis:6379/0

# Empty placeholders. Google OAuth and the real Anthropic API are not exercised
# in the local stack (ANTHROPIC_MOCK=true). Fill these in locally if you need
# to test the real integrations -- but do not commit the values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
