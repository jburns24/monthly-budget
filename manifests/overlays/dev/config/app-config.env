# Non-secret configuration for the local k8s dev stack.
#
# Consumed by configMapGenerator as ConfigMap/app-config. Every workload picks
# it up wholesale via `envFrom`, and postgres reads individual keys from it.
#
# NOTE ON COMMENTS: kustomize does NOT strip trailing comments from env files --
# `FOO=bar # note` yields the literal value "bar # note". Keep every comment on
# its own line.
POSTGRES_USER=monthly_budget
POSTGRES_DB=monthly_budget

# DATABASE_URL and the optional DATABASE_MIGRATION_URL (falls back to
# DATABASE_URL when unset) are secrets and live in app-secrets.env, not here.
# DATABASE_MIGRATION_URL only matters when DATABASE_URL points at hosted
# Supabase's Supavisor transaction pooler (port 6543), which disallows the
# prepared statements Alembic's DDL needs -- see
# docs/data-layer-ports-design.md, "Connecting to hosted Supabase". Local dev
# always talks to the in-cluster postgres Service, so it needs neither.

# Receipt scanning runs against the mock Anthropic client in dev, so no real
# API key is needed and the e2e receipt specs behave deterministically.
ANTHROPIC_MOCK=true
ANTHROPIC_MOCK_SCENARIO=success

# Must match the volumeMount path on the backend Deployment.
RECEIPT_STORAGE_PATH=/data/receipts

ENVIRONMENT=development
LOG_LEVEL=INFO

# JWT lifetimes (optional — these are the Settings defaults). Override here to
# lengthen local sessions without code changes. See backend/app/routers/AGENTS.md.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google's token exchange rejects the request unless the redirect_uri sent by
# the backend (app/services/google_oauth.py) byte-matches the one the browser
# used on the authorize call. LoginPage builds that from
# `window.location.origin + /auth/callback`, and under this stack the origin is
# the Traefik ingress -- localhost:8080, not the bare Vite port. Without this
# key the backend falls back to its config.py default of localhost:5173 and the
# callback fails with redirect_uri_mismatch.
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback
