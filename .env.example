# PostgreSQL configuration
POSTGRES_USER=monthly_budget
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=monthly_budget

# Redis configuration
REDIS_PASSWORD=changeme_redis_password

# Assembled connection URLs (used by the backend app and alembic)
DATABASE_URL=postgresql+asyncpg://monthly_budget:changeme_postgres_password@localhost:5432/monthly_budget
REDIS_URL=redis://:changeme_redis_password@localhost:6379/0

# Backend application secrets
SECRET_KEY=changeme_secret_key_min_32_chars_long
JWT_SECRET=changeme_jwt_secret_min_32_chars_long

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Anthropic API (for receipt scanning)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MOCK=false
ANTHROPIC_MOCK_SCENARIO=success

# Receipt storage
RECEIPT_STORAGE_PATH=/data/receipts

# Application settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend settings
VITE_API_BASE_URL=http://localhost:8000

# Optional: override the GITHUB_TOKEN used for `task skills:*` (agent-skills OCI
# registry auth). Auto-derived from `gh auth token` if unset.
# GITHUB_TOKEN=
